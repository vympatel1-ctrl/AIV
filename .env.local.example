# =============================================================
# Aurum Studio · Environment template
# Copy this file to `.env.local` and fill in real values.
# In Cursor: ⌘⇧P -> "Cursor Settings: Open" -> add via env editor,
# OR just paste into .env.local at the project root.
# =============================================================

# ---- App ---------------------------------------------------------------
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ---- Supabase ----------------------------------------------------------
# Project Settings → API.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ---- AI providers ------------------------------------------------------
# OpenAI: text + gpt-image-1
OPENAI_API_KEY=
# Optional model overrides
OPENAI_TEXT_MODEL=gpt-4o-mini
OPENAI_IMAGE_MODEL=gpt-image-1

# fal.ai (default video provider; routes Kling/Veo/Runway/etc.)
FAL_KEY=
DEFAULT_VIDEO_MODEL=fal-ai/kling-video/v2.5-turbo/pro/image-to-video
DEFAULT_TEXT_VIDEO_MODEL=fal-ai/kling-video/v2.5-turbo/pro
VIDEO_PROVIDER=fal

# ElevenLabs (voiceover from scripts)
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=JBFqnCBsd6RMkjVDRZzb
ELEVENLABS_MODEL_ID=eleven_multilingual_v2

# Runway (optional; only needed if you set VIDEO_PROVIDER=runway)
RUNWAY_API_KEY=

# ---- Video link import (Studio · From video tab) ----------------------
# Direct .mp4 / .webm URLs always work without setting anything below.
#
# To import TikTok / Instagram / YouTube / X / Reddit etc. links, point
# this at a cobalt API instance (https://github.com/imputnet/cobalt).
# The protocol is built in — any cobalt instance works as-is.
#
# Three ways to get a cobalt URL:
#
# 1) Self-host with one Docker command (recommended for prod):
#    docker run -d -p 9000:9000 \
#      -e API_URL="https://your-cobalt.example.com/" \
#      ghcr.io/imputnet/cobalt:10
#    VIDEO_INGEST_RESOLVER_URL=https://your-cobalt.example.com/
#
# 2) Run cobalt locally for dev (works only on your laptop):
#    docker run -d -p 9000:9000 -e API_URL="http://localhost:9000/" \
#      ghcr.io/imputnet/cobalt:10
#    VIDEO_INGEST_RESOLVER_URL=http://localhost:9000/
#
# 3) Use a community public instance (less reliable, may rate-limit):
#    Pick one from https://instances.cobalt.best
#    VIDEO_INGEST_RESOLVER_URL=https://<chosen-instance>/
#
# If your instance requires API keys, set the key here (sent as
# `Authorization: Api-Key <KEY>` per cobalt's spec).
VIDEO_INGEST_RESOLVER_URL=
VIDEO_INGEST_RESOLVER_KEY=

# ---- Mock auth (MVP only — TODO swap for real Supabase Auth) ----------
MOCK_USER_ID=00000000-0000-0000-0000-000000000001
MOCK_USER_EMAIL=demo@aiv.app

# ---- Admin (comma-separated emails to grant admin role) ----------------
ADMIN_EMAILS=demo@aiv.app

# =============================================================
# Stripe is intentionally NOT wired in this MVP. Keys here for later:
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=
# NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
# =============================================================
